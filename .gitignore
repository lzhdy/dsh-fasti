# 依赖
node_modules/
# 构建产物（可从源码重建）
lib/
# 压缩包与发布包
*.tgz
*.zip
# 凭据与本地配置
*.credentials.yaml
.env
# 系统与临时文件
.DS_Store
*.tmp
test-out.txt
